{
  "name": "factory-commit-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Factory Commit desktop app",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node electron/dev.mjs",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --config ../e2e/playwright.config.ts --trace off",
    "dist": "npm run build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-router-dom": "7.18.6",
    "recharts": "3.11.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
