# Copy to .env and change every "change-me". Never commit .env.
# docker compose reads this file; the backend loads it with Pydantic BaseSettings.

# ---------- App ----------
APP_MODE=demo                     # demo | production. Default is production. demo enables the simulator and
                                  # demo reset, and allows the change-me secrets below (with a warning)
APP_NAME=Factory Commit
APP_TIMEZONE=Asia/Kuala_Lumpur    # times are stored in UTC and shown in this zone
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_BIND_ADDRESS=127.0.0.1        # 0.0.0.0 to let other computers reach the API; all other ports stay local
CORS_ALLOWED_ORIGINS=app://.,http://localhost:5173   # app://. is the packaged desktop app

# ---------- Security ----------
JWT_SECRET=change-me-long-random  # required; 32+ random characters (production refuses to start otherwise)
JWT_EXPIRE_MINUTES=480
ADMIN_EMAIL=admin@factory.local   # required; first admin user, created by the seed
ADMIN_INITIAL_PASSWORD=change-me  # required; also the password of the demo users

# ---------- Database ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=factory
POSTGRES_USER=factory
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://factory:change-me@postgres:5432/factory   # required

# ---------- Message queue ----------
RABBITMQ_URL=amqp://factory:change-me@rabbitmq:5672/   # required
RABBITMQ_DEFAULT_USER=factory
RABBITMQ_DEFAULT_PASS=change-me
TASK_DEFAULT_TIMEOUT_SECONDS=120
TASK_MAX_ATTEMPTS=3

# ---------- AI provider (Grafilab, OpenAI-compatible) ----------
# Needed for PO reading, chat and explanations. Put the key here; never commit it.
AI_BASE_URL=https://llm.grafilab.ai/v1
AI_API_KEY=
# Default model for every agent.
AI_MODEL=grafilab/glm-5.3-flash
# Per-agent model. Leave empty to use AI_MODEL. The heavy work (chat, PO reading) uses Gemini.
AI_MODEL_ORCHESTRATOR=gemini/gemini-3.8-flash
AI_MODEL_ORDER=gemini/gemini-3.8-flash
AI_MODEL_PLANNING=
AI_MODEL_MATERIAL=
AI_MODEL_QUALITY=
AI_MODEL_MAINTENANCE=
AI_MODEL_MONITORING=
# USD per million tokens [input, output, cached input] per model, for the cost log and the daily limit.
# A model missing here counts as 0. Grafilab prices as of 2026-11-25.
AI_PRICES={"grafilab/glm-5.3-flash": [0.08, 0.26, 0.02], "gemini/gemini-3.8-flash": [0.49, 2.45, 0.49]}
LLM_MAX_TOKENS=4096
# Above this daily spend, non-critical AI calls stop for the day.
LLM_DAILY_COST_LIMIT_USD=20
# PO reading keeps working after the limit above, but stops at this separate cap (protects against email floods).
LLM_EXTRACTION_DAILY_COST_LIMIT_USD=10

# ---------- Email intake (dev: GreenMail) ----------
IMAP_HOST=greenmail
IMAP_PORT=3143
IMAP_USER=orders@factory.local
IMAP_PASSWORD=change-me
IMAP_USE_SSL=false
IMAP_FOLDER=INBOX
SMTP_HOST=greenmail               # simulator only, to drop demo POs
SMTP_PORT=3025
EMAIL_POLL_SECONDS=60
DOCUMENT_STORAGE_PATH=/data/documents

# ---------- Business rules (admin can override in Settings) ----------
EXTRACTION_CONFIDENCE_THRESHOLD=0.85
HOLD_EXPIRY_HOURS=48
APPROVAL_REMINDER_HOURS=4
APPROVAL_ESCALATION_HOURS=8
QC_BUFFER_HOURS=4
SHIPPING_BUFFER_DAYS=1
OVERTIME_RATE_PER_HOUR=0
CURRENCY=MYR
STOCK_COUNT_WARNING_DAYS=30
PLANNING_SOLVER_TIME_LIMIT_SECONDS=30

# ---------- Demo simulator ----------
SIM_SEND_POS=true                 # false: the simulator only runs the machines (no demo POs)
SIM_PO_INTERVAL_SECONDS=3600      # one demo PO an hour (was every 5 minutes)
SIM_SKIP_AI=true                  # demo POs carry their own values, so reading them costs no AI call
SIM_MACHINE_EVENT_INTERVAL_SECONDS=20
SIM_BREAKDOWN_CHANCE_PER_HOUR=0.05
SIM_RANDOM_SEED=42

# ---------- Backups ----------
BACKUP_PATH=/backups               # inside the backup container; files appear in ./backups on the host
BACKUP_CRON=0 * * * *             # hourly pg_dump; use managed point-in-time restore in production
BACKUP_KEEP=72                      # number of newest dumps to keep

# ---------- Desktop app (copy these into desktop/.env) ----------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_USE_MOCKS=false
